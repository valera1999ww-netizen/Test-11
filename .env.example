# Telegram BotFather token
BOT_TOKEN=123456789:REPLACE_ME

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789

# Render sets PORT automatically. Local default:
WEB_HOST=0.0.0.0
WEB_PORT=10000

# Broadcast pacing in seconds between messages
BROADCAST_DELAY=0.08

# Main Telegram channel used for subscription gate and checks
CHANNEL_USERNAME=@ua_2024k
# Optional numeric chat ID (useful for private channels). Leave empty for public channels.
CHANNEL_CHAT_ID=

# Production: PostgreSQL URL from Render.
# Local: leave empty to use SQLite at data/reward_bot.db
DATABASE_URL=
